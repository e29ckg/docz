# ==============================================================================
# DOCZ System Environment Configuration (.env)
# ระบบงานสารบรรณอิเล็กทรอนิกส์ DOCZ (Pure Node.js & Vue 3 Modern Architecture)
# ==============================================================================

# พอร์ตสำหรับรัน Express Backend Server (ค่าเริ่มต้น: 3000)
PORT=3000
NODE_ENV=production

# การเชื่อมต่อฐานข้อมูล MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=docz

# รหัสความปลอดภัยสำหรับเข้ารหัส JSON Web Token (JWT) - ควรเปลี่ยนเป็นข้อความสุ่มความยาวไม่ต่ำกว่า 32 ตัวอักษร
JWT_SECRET=replace_with_a_very_secure_long_random_string_key_2026

# รายการ Origin ที่อนุญาตให้เชื่อมต่อ API ผ่าน CORS (คั่นด้วยเครื่องหมายจุลภาค ,)
# ตัวอย่าง: http://localhost:5173,http://10.37.64.1:3000,https://saraban.coj.go.th
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ชื่อหน่วยงาน/ศาล สำหรับประทับตรายางรับหนังสือ (หากไม่ระบุจะใช้ค่าเริ่มต้นของระบบ)
COURT_NAME=ศาลเยาวชนและครอบครัวจังหวัดประประจวบคีรีขันธ์
