Options -Indexes
<FilesMatch "(?i)(?:^index-test\.php$|\.(?:zip|sql|cfg|ini|log|md|ya?ml)$)">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Route even existing files through permission checks, before !-f.
    RewriteRule ^uploads/docz/(.*)$ file.php?path=uploads/docz/$1 [B,END]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
